# MeetingOS environment variables
# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
NODE_ENV=development

# --- Database & cache ---
DATABASE_URL=postgresql://meetingos:meetingos@localhost:5432/meetingos
REDIS_URL=redis://localhost:6379

# --- Service URLs (local dev) ---
WEB_URL=http://localhost:3000
BFF_URL=http://localhost:4000
ORCHESTRATOR_URL=http://localhost:8000

# --- Auth (NextAuth + Google OAuth) ---
# Create at https://console.cloud.google.com/apis/credentials
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM + ASR ---
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (Whisper + text-embedding-3-small)
OPENAI_API_KEY=

# --- Observability ---
# LangSmith: https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meetingos
LANGSMITH_TRACING=true

# --- Tool integrations (MCP targets) ---
# Linear: https://linear.app/settings/api
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Gmail: uses Google OAuth scopes above; no separate key
# GMAIL_DRAFTS_ONLY is an invariant of the MVP — never send from agents
GMAIL_DRAFTS_ONLY=true
